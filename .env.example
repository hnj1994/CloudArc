# ---- core ----
CLOUDARC_DATA_DIR=/data
CLOUDARC_BASE_CURRENCY=INR
# Organization name shown as "Prepared by" and in report footers
CLOUDARC_ORG_NAME=CloudArc
# 32 random bytes, base64. Encrypts stored client secrets (AES-256-GCM). Back it up separately.
CLOUDARC_MASTER_KEY=
CLOUDARC_HOSTNAME=cloudarc.internal

# ---- authentication: "entra" (SSO + MFA via Entra ID, plus API tokens) or "dev" (API tokens only) ----
CLOUDARC_AUTH_MODE=entra
CLOUDARC_ENTRA_TENANT_ID=
CLOUDARC_ENTRA_CLIENT_ID=

# ---- sync ----
CLOUDARC_SCHEDULER_ENABLED=true
CLOUDARC_SYNC_HOUR_UTC=2
CLOUDARC_SYNC_LOOKBACK_DAYS=5
CLOUDARC_INITIAL_BACKFILL_MONTHS=3
CLOUDARC_RETENTION_MONTHS=24
# Fallback FX rates to INR when no dated rate is loaded (POST /api/fx-rates)
CLOUDARC_FX_DEFAULTS={"USD": 88.0, "EUR": 103.0, "GBP": 118.0}

# ---- e-mail alerts ----
CLOUDARC_SMTP_HOST=
CLOUDARC_SMTP_PORT=587
CLOUDARC_SMTP_USER=
CLOUDARC_SMTP_PASSWORD=
CLOUDARC_SMTP_FROM=

# ---- optional LLM narrative (requires an approved data-handling policy) ----
CLOUDARC_LLM_PROVIDER=
CLOUDARC_LLM_MODEL=claude-opus-5-5
CLOUDARC_LLM_DATA_POLICY_APPROVED=false
# ANTHROPIC_API_KEY=

# ---- recommendation assumptions when retail prices are unavailable ----
CLOUDARC_RI_DISCOUNT_1Y=0.35
CLOUDARC_RI_DISCOUNT_3Y=0.55
